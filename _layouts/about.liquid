---
layout: default
---
<div class="post about-page editorial-home">
  <section class="about-hero" aria-labelledby="about-title">
    <div class="hero-copy">
      {% if page.subtitle %}
        <p class="eyebrow">{{ page.subtitle }}</p>
      {% endif %}
      <h1 id="about-title">
        {{ site.first_name }}
        {{ site.last_name }}
        <span class="name-nickname">(Barry)</span>
      </h1>
      {% if page.role %}
        <p class="hero-role">{{ page.role }}</p>
      {% endif %}
      {% if page.introduction %}
        <div class="introduction">{{ page.introduction | markdownify }}</div>
      {% endif %}
      <div class="hero-links" aria-label="Professional information">
        <a href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">↗</span></a>
        <a href="{{ '/cv/' | relative_url }}">Curriculum vitae <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {% if page.profile %}
      <aside class="portrait-column" aria-label="Portrait and profiles">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% assign profile_image_alt = site.first_name | append: ' ' | append: site.last_name %}
          {% include figure.liquid loading="eager" path=profile_image_path class="portrait-image" sizes="(max-width: 600px) 72vw, 300px" alt=profile_image_alt cache_bust=true %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {% if page.social %}
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </aside>
    {% endif %}
  </section>

  <article>
    <section class="home-section research-section" aria-labelledby="research-title">
      <div class="section-heading">
        <h2 id="research-title">Research</h2>
        <span class="section-index" aria-hidden="true">01</span>
      </div>
      {{ content }}
    </section>

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section news-section" aria-labelledby="news-title">
        <div class="section-heading">
          <h2 id="news-title"><a href="{{ '/news/' | relative_url }}">Latest</a></h2>
          <span class="section-index" aria-hidden="true">02</span>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section" aria-labelledby="posts-title">
        <div class="section-heading">
          <h2 id="posts-title"><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section selected-section" aria-labelledby="publications-title">
        <div class="section-heading">
          <h2 id="publications-title">Selected publications</h2>
          <a class="section-link" href="{{ '/publications/' | relative_url }}">View all <span aria-hidden="true">↗</span></a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.personal_note %}
      <section class="home-section beyond-section" aria-labelledby="beyond-title">
        <div class="section-heading">
          <h2 id="beyond-title">Beyond the lab</h2>
          <span class="section-index" aria-hidden="true">04</span>
        </div>
        <div class="personal-note">{{ page.personal_note | markdownify }}</div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
